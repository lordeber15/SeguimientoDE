# Copiar este archivo como ".env" y llenar los valores antes de ejecutar docker compose up.
# Ninguno de los valores de abajo es real: son solo el formato esperado.
NODE_ENV=production

# ==== PUERTOS (control total) ====
# Backend Express — puerto interno del contenedor y publicado en el host
PORT=3012
BACKEND_HOST_PORT=3012

# Frontend Vite (dev server con HMR dentro de Docker)
FRONTEND_PORT=5177
FRONTEND_HOST_PORT=5177

# URL del backend accesible desde el NAVEGADOR del usuario (no desde dentro de Docker).
# En IP de LAN para que las demás máquinas de la red puedan hacer fetch al backend — si se deja
# en "localhost", el navegador de CADA OTRA PC intenta conectarse a SU PROPIA máquina, no a esta,
# y el fetch falla.
VITE_API_URL=http://192.168.x.x:3012

DB_DIALECT=postgres
DB_HOST=
DB_PORT=
DB_NAME=sgd
DB_USER=
# IMPORTANTE: ejecutar en PostgreSQL antes de activar:
#   ALTER USER <usuario> WITH PASSWORD '<clave nueva>';
DB_PASS=
DB_SCHEMA=IDOSGD

# DNIs que se siembran como administradores y jefes la PRIMERA vez que arranca la BD propia.
# A partir de ahí los roles se gestionan desde la aplicación: editar esto ya no cambia nada de
# lo asignado, solo afecta a una instalación nueva (ver docs/PLAN-AUTENTICACION.md).
ADMIN=
JEFES=

# ==== BASE DE DATOS PROPIA (contenedor db-app) ====
# Usuarios de la aplicación, roles, auditoría y los embeddings del RAG.
# Es una base DISTINTA de la del SGD: aquí sí se escribe.
APP_DB_HOST=db-app
APP_DB_PORT=5432
APP_DB_NAME=seguimiento_app
APP_DB_USER=seguimiento
APP_DB_PASS=
# Puerto publicado en el host, para inspeccionar la BD con un cliente externo.
APP_DB_HOST_PORT=5442

# Sesión: cuánto dura el token y el bloqueo local por intentos fallidos.
JWT_EXPIRACION=78h
LOGIN_MAX_INTENTOS=10
LOGIN_BLOQUEO_MINUTOS=15
# PDF unificado: dónde se dejan los temporales.
# UNION_TMP_DIR es la ruta EN EL HOST (barras normales: docker-compose no interpreta las
# invertidas de Windows en un bind mount). UNION_TMP_PATH es la ruta DENTRO del contenedor,
# que es la que lee el backend. Se monta en modo lectura/escritura: es nuestro directorio de
# trabajo, no tiene nada que ver con el repositorio del SGD, que va en :ro.
UNION_TMP_DIR=
UNION_TMP_PATH=/mnt/sgd/tmp
# Horas que se conserva un PDF unificado antes de que la limpieza lo borre.
UNION_TTL_HORAS=6

# Generado con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CORS: el API esta en dominio SEPARADO del frontend, asi que aqui deben ir
# los ORIGENES del FRONTEND (uno o varios, separados por coma, sin barra final).
# Debe coincidir con el dominio/puerto desde donde se sirve el frontend.
#   Ejemplo dominio: CORS_ORIGIN=https://mpv.ue118.gob.pe
CORS_ORIGIN=http://localhost:5177

# Clave del SGD para validar usuarios INTERNOS existentes (AES-128-ECB). NO rotar.
SGD_SECRET_KEY_PASSWORD=

# Ruta DENTRO del contenedor donde se montan los documentos/anexos.
STORAGE_PATH=/mnt/sgd/storage

# Origen EN EL HOST del repositorio de documentos del SGD. docker-compose lo monta en
# STORAGE_PATH en modo solo lectura (:ro). En el servidor Linux de producción esto apunta al
# repositorio real, normalmente /mnt/sgd/storage.
# Si el repositorio vive en OTRA máquina (servidor del SGD), dejar STORAGE_HOST_PATH sin definir:
# docker-compose monta un volumen vacío y encima se monta sshfs A MANO, sin guardar credenciales:
#   docker compose exec -u root backend sgd-sshfs montar usuario@host:/ruta/remota
#   docker compose exec -u root backend sgd-sshfs desmontar | estado
# Opcional: SGD_SSHFS_REMOTE=usuario@host:/ruta evita teclear el destino (nunca la contraseña).
STORAGE_HOST_PATH=

# ==== STD (Sistema de Trámite Documentario de UE118/PMESUT) — SOLO LECTURA ====
# Sistema legado (MariaDB), hoy casi solo de consulta. STD_HABILITADO es el interruptor general:
# en "false" (o sin estas variables) el backend arranca igual y el módulo STD responde "no
# disponible" sin tumbar nada — ver stdDatabase.stdDisponible() en el backend.
# IMPORTANTE: STD_DB_USER debe ser un usuario de MariaDB con ÚNICAMENTE GRANT SELECT. El código
# además fuerza "SET SESSION TRANSACTION READ ONLY" en cada conexión y rechaza cualquier consulta
# que no empiece por SELECT/WITH (consultarStd en stdDatabase.ts) — tres capas, ninguna de más.
STD_HABILITADO=false
STD_DB_HOST=
STD_DB_PORT=3306
STD_DB_NAME=stdpmesut_db_pmesut
STD_DB_USER=
STD_DB_PASS=

# Archivos del STD (carpeta uploads/ de la app PHP legada: documentos y anexos de tbl_adjunto),
# montados en el contenedor en SOLO LECTURA (:ro), igual que STORAGE_PATH del SGD arriba.
# STD_STORAGE_HOST_PATH es la ruta EN EL HOST (o el punto donde se monte por sshfs/red);
# STD_STORAGE_PATH es la ruta DENTRO del contenedor, la que de verdad lee el backend.
STD_STORAGE_HOST_PATH=
STD_STORAGE_PATH=/mnt/std/uploads
# Tope por archivo, en bytes (104857600 = 100 MB). STD_VERIFICAR_HASH compara cada archivo leído
# contra tbl_adjunto.hash (sha1 del contenido) antes de servirlo — más lento, pero detecta un
# montaje corrupto o incompleto en vez de servir bytes equivocados. Apagado por defecto.
STD_MAX_BYTES=104857600
STD_VERIFICAR_HASH=false

# Base RAG propia del STD (vectores, chunks, chat): una base de datos SEPARADA ("std_rag" por
# defecto) para no mezclar nunca su corpus con el del SGD. Se crea sola al arrancar si no existe.
# Por defecto usa las MISMAS credenciales que APP_DB_* de arriba (mismo servidor Postgres, mismo
# superusuario de la imagen pgvector) — solo llenar estas si se quiere un usuario o un servidor
# Postgres distinto para esta base.
STD_RAG_DB_HOST=
STD_RAG_DB_PORT=
STD_RAG_DB_NAME=std_rag
STD_RAG_DB_USER=
STD_RAG_DB_PASS=

# ==== PROVEEDORES DE IA (Fase 3) ====
# Chat y embeddings se eligen POR SEPARADO. Anthropic NO tiene embeddings: si se pone en
# EMBEDDING_PROVIDER, el arranque lo avisa. Recomendación de gobernanza: embeddings en local
# (ollama) y chat con el proveedor que se prefiera — por embeddings pasa el corpus ENTERO,
# mientras que el chat solo ve 12 fragmentos por consulta.
#
# Valores: EMBEDDING_PROVIDER = ollama | openai | azure
#          CHAT_PROVIDER      = ollama | openai | azure | anthropic
EMBEDDING_PROVIDER=ollama
CHAT_PROVIDER=openai

# --- Ollama (local, SIN API key). Para activarlo basta con tenerlo corriendo. ---
# host.docker.internal, no localhost: el backend corre DENTRO de un contenedor, y "localhost"
# ahí es el propio contenedor, no esta máquina.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=bge-m3
#OLLAMA_EMBED_MODEL=qwen3.5:4b
OLLAMA_EMBED_DIM=1024
#OLLAMA_CHAT_MODEL=qwen3.5:4b-q4_K_M

# --- OpenAI. Para activarlo: EMBEDDING_PROVIDER/CHAT_PROVIDER=openai y descomentar la clave. ---
# La extracción con IA de visión ("Extraer con ChatGPT") SOLO necesita OPENAI_API_KEY — es
# independiente de EMBEDDING_PROVIDER/CHAT_PROVIDER (ver providerFactory.visionDisponible).
#OPENAI_API_KEY=
#OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# No usar gpt-4o-mini aquí: el manejo de imágenes de página de mini es justo la debilidad que
# esta función existe para cubrir.
OPENAI_VISION_MODEL=gpt-4o

# --- Anthropic (solo chat). Para activarlo: CHAT_PROVIDER=anthropic y descomentar la clave. ---
#ANTHROPIC_API_KEY=
#ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# --- Azure OpenAI. Enruta por DEPLOYMENT, no por nombre de modelo. ---
#AZURE_OPENAI_ENDPOINT=
#AZURE_OPENAI_API_KEY=
#AZURE_EMBED_DEPLOYMENT=
#AZURE_CHAT_DEPLOYMENT=
#AZURE_OPENAI_API_VERSION=2024-10-21

# Timeout de las llamadas a proveedores de IA.
IA_TIMEOUT_MS=120000

# ==== markitdown (PDF -> Markdown). No necesita API key. ====
# Mismo motivo que OLLAMA_URL: dentro del contenedor, localhost:8001 no es este equipo.
MARKITDOWN_URL=http://host.docker.internal:8001
MARKITDOWN_TIMEOUT_MS=180000
MARKITDOWN_MAX_BYTES=52428800

# ==== MinerU (PDF/DOCX/XLSX/PPTX/imagen -> Markdown, con OCR real). backend=pipeline fijo. ====
# Mismo motivo que MARKITDOWN_URL: dentro del contenedor, localhost:8013 no es este equipo.
MINERU_URL=http://host.docker.internal:8013
MINERU_TIMEOUT_MS=300000
MINERU_MAX_BYTES=52428800
MINERU_LANG_LIST=ch
MINERU_PARSE_METHOD=auto

# ==== Selector de proveedor de conversión a Markdown: markitdown | mineru ====
RAG_CONVERTER_PROVIDER=markitdown
# Conversor de respaldo: se reintenta el MISMO documento con él si el de arriba falla (por
# cualquier motivo: archivo rechazado, timeout, red o servicio caído). Sin la variable, el respaldo
# es "el otro"; `ninguno` lo desactiva y deja un único intento, como antes.
RAG_CONVERTER_FALLBACK=mineru

# ==== Troceado ====
RAG_CHUNK_TOKENS=700
RAG_CHUNK_SOLAPE=120
RAG_MIN_CARACTERES=200
# Documentos largos (conversionLargaService): trocea PDFs por encima del umbral en bloques de
# pocas paginas para que el documento entero deje de tener limite de tiempo, sin que ninguna
# llamada HTTP individual pierda el suyo (180s markitdown / 300s mineru siguen igual).
RAG_PAGINAS_UMBRAL_TROCEO=25
RAG_PAGINAS_POR_BLOQUE=15
# Tope de reintentos ante un fallo REINTENTABLE de conversion (timeout, red, circuito): sin esto
# un documento que siempre tarda demasiado vuelve a pendiente en cada fallo para siempre.
RAG_MAX_INTENTOS_CONVERSION=5
